<ac:structured-macro ac:name="toc">
  <ac:parameter ac:name="printable">true</ac:parameter>
  <ac:parameter ac:name="style">disc</ac:parameter>
  <ac:parameter ac:name="maxLevel">4</ac:parameter>
</ac:structured-macro>

<table style="width:100%; border-collapse: collapse;" data-layout="default">
    <tbody>
      <tr>
        <td style="border:1px solid #bbb; padding:8px;" colspan="2">
          <h2 style="margin:0;"><%= locals.title || 'L1 ALLEGRA user time performance report' %></h2>
        </td>
        <td style="border:1px solid #bbb; padding:8px;" colspan="2">
          <div style="font-size:12px; line-height:1.4;">
            <div><h3>User campaign:</h3> <%= locals.userCampaign || '' %></div>
            <div><%= locals.daysLabel || '' %></div>
            <div><%= locals.dateRange || '' %></div>
          </div>
        </td>
      </tr>
  
      <!-- Requested specifications -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>REQUESTED SPECIFICATIONS</h3>
        </td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; width:25%;">pulse energy:</td>
        <td style="border:1px solid #bbb; padding:6px;" colspan="3"><%= locals.pulseEnergy || '' %></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px;">pulse duration:</td>
        <td style="border:1px solid #bbb; padding:6px;" colspan="3"><%= locals.pulseDuration || '' %></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px;">wavelength:</td>
        <td style="border:1px solid #bbb; padding:6px;" colspan="3"><%= locals.wavelength || '' %></td>
      </tr>
  
      <!-- Hour count -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>HOUR COUNT</h3>
        </td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; width:25%;"><h3>TOTAL ACTIVE DAYS:</h3></td>
        <td style="border:1px solid #bbb; padding:6px; width:25%;"><h3>TOTAL ACTIVE HOURS:</h3></td>
        <td style="border:1px solid #bbb; padding:6px; width:25%;">
          <h3>USED ALIGNMENT BEAMTIME HOURS:</h3>
          <div style="font-size:12px;">Main number from the archiver (number in brackets from the operator log)</div>
        </td>
        <td style="border:1px solid #bbb; padding:6px; width:25%;">
          <h3>USED HIGH POWER BEAMTIME HOURS:</h3>
          <div style="font-size:12px;">Main number from the archiver (number in brackets from the operator log)</div>
        </td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px;"><%= locals.totalActiveDays ?? '' %></td>
        <td style="border:1px solid #bbb; padding:6px;"><%= locals.totalActiveHours ?? '' %></td>
        <td style="border:1px solid #bbb; padding:6px;">
          <%= locals.usedAlignmentBeamtimeHoursMainNumberFromTheArchiverNumberInBracketsFormTheOperatorLog ?? '' %>
        </td>
        <td style="border:1px solid #bbb; padding:6px;">
          <%= locals.usedHighPowerBeamtimeHoursMainNumberFromTheArchiverNumberInBracketsFormTheOperatorLog ?? '' %>
        </td>
      </tr>
  
      <!-- Energy graphs -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>ENERGY GRAPHS</h3>
          <div style="font-size:12px;">Time Zone: <%= locals.timeZone || '' %></div>
        </td>
      </tr>
      <% if (locals.days && Array.isArray(locals.days) && locals.days.length) { %>
        <% locals.days.forEach(function(day){ %>
          <tr>
            <td style="border:1px solid #bbb; padding:6px;" colspan="4"><h4>DAY <%= day.number || '' %></h4></td>
          </tr>
          <tr>
            <td style="border:1px solid #bbb; padding:6px; min-height:300px;" colspan="4">
              <% if (day.graphUrl) { %>
                <ac:image ac:align="center" ac:width="800" ac:height="400" ac:alt="Day <%= day.number || '' %> energy graph">
                  <ri:attachment ri:filename="<%= day.graphUrl %>" />
                </ac:image>
              <% } %>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td style="border:1px solid #bbb; padding:6px; min-height:300px;" colspan="4"></td>
        </tr>
      <% } %>
  
      <!-- Dazzler settings -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4"><h3>DAZZLER SETTINGS</h3></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px;" colspan="4">
          <% if (locals.dazzlerSettings && Array.isArray(locals.dazzlerSettings)) { %>
            <ul style="margin:0; padding-left:18px;">
              <% locals.dazzlerSettings.forEach(function(item){ %>
                <li><%= item || '' %></li>
              <% }); %>
            </ul>
          <% } else { %>
            <%= locals.dazzlerSettings || '' %>
          <% } %>
        </td>
      </tr>

      <!-- Beam Profile -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>NEAR FIELD PROFILE</h3>
        </td>
      </tr>
      <% if (locals.days && Array.isArray(locals.days) && locals.days.length) { %>
        <% locals.days.forEach(function(day){ %>
          <tr>
            <td style="border:1px solid #bbb; padding:6px;" colspan="4"><h4>DAY <%= day.number || '' %></h4></td>
          </tr>
          <tr>
            <td style="border:1px solid #bbb; padding:6px; min-height:400px;" colspan="4">
              <% if (day.nearFieldProfileGraph) { %>
                <ac:image ac:align="center" ac:width="800" ac:height="400" ac:alt="Day <%= day.number || '' %> beam profile graph">
                  <ri:attachment ri:filename="<%= day.nearFieldProfileGraph %>" />
                </ac:image>
                <div style="text-align:center; color:#666; padding:50px;">Beam Profile Graph Placeholder</div>
              <% } %>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td style="border:1px solid #bbb; padding:6px; min-height:400px;" colspan="4">
            <div style="text-align:center; color:#666; padding:50px;">No beam profile data available</div>
          </td>
        </tr>
      <% } %>

      <!-- Beam Pointing (RMS BY DAY) -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>FAR FIELD PROFILE</h3>
        </td>
      </tr>
      <% if (locals.days && Array.isArray(locals.days) && locals.days.length) { %>
        <% locals.days.forEach(function(day){ %>
          <tr>
            <td style="border:1px solid #bbb; padding:6px;" colspan="4"><h4>DAY <%= day.number || '' %></h4></td>
          </tr>
          <tr>
            <td style="border:1px solid #bbb; padding:6px; min-height:400px;" colspan="4">
              <% if (day.farFieldProfileGraph) { %>
                <ac:image ac:align="center" ac:width="800" ac:height="400" ac:alt="Day <%= day.number || '' %> beam pointing graph">
                  <ri:attachment ri:filename="<%= day.farFieldProfileGraph %>" />
                </ac:image>
              <% } else { %>
                <div style="text-align:center; color:#666; padding:50px;">Beam Pointing Graph Placeholder</div>
              <% } %>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td style="border:1px solid #bbb; padding:6px; min-height:400px;" colspan="4">
            <div style="text-align:center; color:#666; padding:50px;">No beam pointing data available</div>
          </td>
        </tr>
      <% } %>

      <!-- Incidents -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; background:#f3f3f3;" colspan="4">
          <h3>INCIDENTS</h3>
        </td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; font-weight:bold; width:20%;">Date-time</td>
        <td style="border:1px solid #bbb; padding:6px; font-weight:bold; width:80%;">Description</td>
      </tr>
      <!-- Empty rows for operator entries -->
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
      <tr>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
        <td style="border:1px solid #bbb; padding:6px; height:30px;"></td>
      </tr>
    </tbody>
  </table>